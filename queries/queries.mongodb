// Select the database
db = db.getSiblingDB("DocEdits");

// 1. Retrieve a document and its collaborators
db.documents.find({
    "_id": 201
});

// 2. Retrieve all edits of a specific document
db.edits.find({
    "document_id": 201
});

// 3. Retrieve another document and its collaborators
db.documents.find({
    "_id": 202
});

// 4. Retrieve all edits of another document
db.edits.find({
    "document_id": 202
});

// 5. Find documents where Terry is a collaborator
db.documents.find({
    "collaborators.username": "Terry"
});
